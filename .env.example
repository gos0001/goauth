# Copy to .env.development and fill in the secrets:
#
#   cp .env.example .env.development
#   make jwt-key      # -> JWT_PRIVATE_KEY
#   make admin-token  # -> ADMIN_TOKEN
#
# .env.development is gitignored. Never commit a real signing key.

APP_ADDR=:8080
APP_ENV=development

# Machine-facing admin listener. Loopback only in development; inside Docker use
# 0.0.0.0:8081 and simply do not publish the port.
ADMIN_ADDR=127.0.0.1:8081
# Empty disables the private admin listener entirely — never a default token.
ADMIN_TOKEN=

# Connections. goauth wants a database of its own — see the README section
# "Give goauth its own database". It creates both the database and its tables on
# first start, so pointing it at a server is enough.
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/goauth_dev?sslmode=disable
REDIS_URL=redis://localhost:6379

# Create the database named in POSTGRES_URL if it is missing. Only this path
# needs the CREATEDB privilege, and it is never taken when the database already
# exists — so a managed Postgres with a pre-created database works untouched.
DB_AUTO_CREATE=true

# Create missing tables at startup. Set false where a deployment pipeline owns
# schema changes; the service then refuses to serve against absent tables.
DB_AUTO_SCHEMA=true

# Ed25519 signing seed, base64 of 32 bytes. Required — the service will not
# start without it, because an auto-generated ephemeral key would silently
# invalidate every issued token on restart.
JWT_PRIVATE_KEY=
# Retired public keys: still published in the JWKS and still accepted for
# verification, never used to sign. This is what makes rotation a two-step
# deploy with no downtime.
JWT_PREVIOUS_PUBLIC_KEYS=
JWT_ISSUER=goauth
JWT_AUDIENCE=goauth
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# closed | open
AUTH_REGISTRATION_MODE=closed
AUTH_MIN_PASSWORD_LEN=12

# Bootstrap administrator, created only when the installation has no active
# admin. The credentials are used exactly as given — nothing is generated and
# nothing is printed to the log, so recreating the database gives you back the
# same working login.
#
# A username or email without a password fails the boot: the alternative is an
# account nobody can sign into. They apply at creation only, so a password
# changed later through /auth/password survives a restart.
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_EMAIL=

# Empty means no forwarding header is ever trusted — correct when the service is
# reached directly. Behind Cloudflare: TRUSTED_PROXIES=cloudflare and
# CLIENT_IP_HEADER=CF-Connecting-IP. Behind nginx: TRUSTED_PROXIES=private and
# CLIENT_IP_HEADER=X-Forwarded-For.
TRUSTED_PROXIES=
CLIENT_IP_HEADER=

# Origins a browser application may call from — a panel or SPA lives on a
# different origin from the API, so without this its requests never leave the
# browser. Comma-separated, each entry a full origin:
#
#   https://app.example.com   one origin
#   https://*.example.com     any subdomain, but not example.com itself
#   http://localhost:3000     development
#   *                         anything
#
# Empty sends no CORS headers, so browsers block cross-origin calls. Note this
# governs browsers only — it stops nothing from curl or a server.
ALLOW_DOMAINS=
CORS_MAX_AGE=12h

RATELIMIT_LOGIN_IP=100/15m
RATELIMIT_LOGIN_PAIR=10/15m
RATELIMIT_REGISTER=20/1h
RATELIMIT_FAIL_CLOSED=true

# How recently a password must have been presented for destructive admin calls.
ADMIN_REAUTH_WINDOW=15m

# Background cleanup. The audit log is written on every login and every token
# refresh, so with a 15-minute access TTL one active user adds roughly four rows
# an hour — it is the table that actually grows.
#
# AUDIT_RETENTION=0 keeps everything forever. Zero deliberately means "keep",
# not "delete": the opposite reading would erase the audit trail of anyone who
# left this unset.
AUDIT_RETENTION=720h
# Hard cap regardless of age, keeping the newest entries. 0 disables it.
AUDIT_MAX_ROWS=0
AUDIT_CLEANUP_INTERVAL=6h

# Expired sessions are not removed when they expire — rotation marks them used
# and the row stays — so they are swept on this interval. 0 disables the job.
SESSION_CLEANUP_INTERVAL=1h

# Webhooks. Empty WEBHOOK_URL disables them entirely — events are then not even
# written to the outbox, so nothing accumulates.
#
# WEBHOOK_SECRET signs each request over "<timestamp>.<body>", so a receiver can
# tell a real event from a POST by anyone who learned the URL, and a captured
# request cannot be replayed. WEBHOOK_API_KEY additionally sends a plain
# X-Goauth-Api-Key header for gateways that filter on one — an addition to the
# signature, never a replacement for it.
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_API_KEY=
WEBHOOK_INTERVAL=10s
WEBHOOK_TIMEOUT=10s
WEBHOOK_MAX_ATTEMPTS=10

# How long a settled event — delivered, or given up on — is kept.
WEBHOOK_RETENTION=168h

# Events that were never delivered and never abandoned. Nothing settles these
# when delivery is switched off or WEBHOOK_INTERVAL is 0, so this ceiling is the
# only thing that bounds them. Far wider than WEBHOOK_RETENTION on purpose:
# deleting one loses it for good. 0 keeps them indefinitely.
OUTBOX_MAX_AGE=720h
OUTBOX_CLEANUP_INTERVAL=1h
