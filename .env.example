# Copy to .env.development and fill in the secrets:
#
#   cp .env.example .env.development
#   make jwt-key      # -> JWT_PRIVATE_KEY
#   make admin-token  # -> ADMIN_TOKEN
#
# .env.development is gitignored. Never commit a real signing key.

APP_ADDR=:8080
APP_ENV=development

# Machine-facing admin listener. Loopback only in development; inside Docker use
# 0.0.0.0:8081 and simply do not publish the port.
ADMIN_ADDR=127.0.0.1:8081
# Empty disables the private admin listener entirely — never a default token.
ADMIN_TOKEN=

# Connections. The schema is created automatically on first start; see
# AUTO_MIGRATE below.
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/goauth_dev?sslmode=disable
REDIS_URL=redis://localhost:6379

# Apply embedded migrations at startup. Set false where a deployment pipeline
# owns schema changes; the service then refuses to boot against a schema that
# has not been applied yet.
AUTO_MIGRATE=true

# Ed25519 signing seed, base64 of 32 bytes. Required — the service will not
# start without it, because an auto-generated ephemeral key would silently
# invalidate every issued token on restart.
JWT_PRIVATE_KEY=
# Retired public keys: still published in the JWKS and still accepted for
# verification, never used to sign. This is what makes rotation a two-step
# deploy with no downtime.
JWT_PREVIOUS_PUBLIC_KEYS=
JWT_ISSUER=goauth
JWT_AUDIENCE=goauth
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# closed | open
AUTH_REGISTRATION_MODE=closed
AUTH_MIN_PASSWORD_LEN=12

# Bootstrap administrator, created only when the installation has no active
# admin. The account is forced to change its password on first login.
#
# Leaving SUPER_ADMIN_PASSWORD empty generates one and prints it to the log
# exactly once, on the run that creates the account — convenient for a first
# `docker run`, but it does mean the password reaches wherever logs are shipped.
# Set it explicitly to suppress generation entirely.
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_EMAIL=

# Empty means no forwarding header is ever trusted — correct when the service is
# reached directly. Behind Cloudflare: TRUSTED_PROXIES=cloudflare and
# CLIENT_IP_HEADER=CF-Connecting-IP. Behind nginx: TRUSTED_PROXIES=private and
# CLIENT_IP_HEADER=X-Forwarded-For.
TRUSTED_PROXIES=
CLIENT_IP_HEADER=

RATELIMIT_LOGIN_IP=100/15m
RATELIMIT_LOGIN_PAIR=10/15m
RATELIMIT_REGISTER=20/1h
RATELIMIT_FAIL_CLOSED=true

# How recently a password must have been presented for destructive admin calls.
ADMIN_REAUTH_WINDOW=15m
